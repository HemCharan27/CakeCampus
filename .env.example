# -- Security -----------------------------------------------------------------
JWT_SECRET=<run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">
ADMIN_PASSWORD=<strong-password>
ADMIN_DEFAULT_PASSWORD=<strong-password>

# -- Server --------------------------------------------------------------------
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
# Public frontend origin. Set this to the deployed frontend URL on Render.
FRONTEND_URL=http://localhost:3000

# Production deployment: https://cakecampus.onrender.com

# -- Database ------------------------------------------------------------------
# Leave blank to use local JSON flat-file storage (./data/)
MONGODB_URI=
DATA_DIR=./data

# -- Payments (UPI) ------------------------------------------------------------
CAMPUS_UPI_ID=cakecampus@okhdfcbank
CAMPUS_UPI_PAYEE_NAME=CakeCampus

# -- Email (Resend) ------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM=CakeCampus <onboarding@resend.dev>
OWNER_EMAIL=your@email.com

# -- Integrations (optional) ---------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# -- Frontend (Vite) -----------------------------------------------------------
# Leave empty if frontend is served together with backend or on the same domain.
# If frontend is deployed separately (e.g. Render Static Site) while backend is
# on Render, set this in the frontend service's Environment tab, then redeploy:
# VITE_API_URL=https://cakecampus.onrender.com
VITE_API_URL=

